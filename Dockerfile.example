# Inert until renamed. Nimbus builds this app with Railpack while `.nimbus.yml`
# says `build.strategy: auto` and no `Dockerfile` exists.
#
# To take over the build:
#   mv Dockerfile.example Dockerfile
#   # set build.strategy: dockerfile in .nimbus.yml
#   docker build -t app . && docker run -p 3000:3000 -e PORT=3000 app
#
# Do not add `output: "standalone"` to next.config.ts to slim this down —
# `next start` does not run against a standalone build.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Production dependencies only, resolved from the same lockfile, so the runner
# never carries eslint/typescript/tailwind into the shipped image.
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup -S -g 1001 nodejs && adduser -S -u 1001 -G nodejs nextjs

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json

USER nextjs

# Documentation only — Nimbus injects $PORT and routes the public URL to it.
# `next start` binds to $PORT, so never hardcode a port in the start command.
EXPOSE 3000

CMD ["npm", "run", "start"]
